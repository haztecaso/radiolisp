{:deps     {:aliases [:dev :test]}
 :dev-http {8080 "resources/public"}

 :builds
 {:app  {:target        :browser
         :output-dir    "resources/public/js"
         :asset-path    "/js"
         :module-loader true
         :modules       {:main {:init-fn radiolisp.frontend.main/init}
                         ;; hls.js only downloads when an HLS station needs it.
                         :hls  {:entries    [radiolisp.frontend.hls]
                                :depends-on #{:main}}}
         :devtools      {:watch-dir "resources/public"}
         ;; In development the page on :8080 talks to `bb backend` on :8090.
         :dev           {:closure-defines {radiolisp.frontend.socket/backend-origin "http://localhost:8090"}}
         ;; `bb build` puts the release in dist/public, away from the dev output.
         :release       {:output-dir "../dist/public/js"}}

  :test {:target    :node-test
         :output-to "target/test/node-tests.js"
         :ns-regexp "-test$"}}}
