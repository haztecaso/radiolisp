{:paths ["scripts"]
 :tasks
 {:requires  ([babashka.fs :as fs])
  :init      (do (def frontend {:dir "frontend"})
                 (def backend {:dir "backend"})
                 ;; Only the source folders that exist, so lint and fmt work from day one.
                 (def clj-dirs (filterv fs/exists? ["common/src" "common/test" "frontend/src" "frontend/test"
                                                    "backend/src" "backend/test" "scripts"])))

  setup      {:doc  "Install the npm dependencies of the frontend"
              :task (shell frontend "npm install")}

  dev        {:doc  "Watch ClojureScript and SCSS (http://localhost:8080) and run the backend (http://localhost:8090)"
              :task (run '-dev {:parallel true})}
  -dev       {:depends [dev:cljs dev:css dev:backend]}
  ;; Debug logs in development, unless LOG_LEVEL says otherwise.
  dev:backend (shell (assoc backend :extra-env {"LOG_LEVEL" (or (System/getenv "LOG_LEVEL") "debug")})
                     "clojure -M -m radiolisp.backend.main")
  dev:cljs   (shell frontend "npx shadow-cljs watch app")
  dev:css    (shell frontend "sass --watch --no-source-map resources/styles/main.scss:resources/public/css/main.css")

  css        {:doc  "Compile the SCSS once, compressed, into dist/public"
              :task (shell frontend "sass --no-source-map --style=compressed resources/styles/main.scss ../dist/public/css/main.css")}

  ;; Every build result goes to dist/: the web in public/, the backend jar beside it.
  build      {:doc     "Frontend and backend into dist/"
              :depends [build:frontend build:backend]}

  build:frontend {:doc     "Release build of the frontend into dist/public"
                  :depends [css]
                  :task    (do (fs/create-dirs "dist/public")
                               (fs/copy "frontend/resources/public/index.html" "dist/public/index.html" {:replace-existing true})
                               (fs/copy-tree "frontend/resources/public/fonts" "dist/public/fonts" {:replace-existing true})
                               (fs/copy-tree "frontend/resources/public/icons" "dist/public/icons" {:replace-existing true})
                               (shell frontend "npx shadow-cljs release app"))}

  build:backend {:doc  "Backend jar into dist/radiolisp-backend.jar (it serves dist/public)"
                 :task (shell backend "clojure -T:build uber")}

  deploy     {:doc     "Build and deploy to your server (DEPLOY_SERVER, DEPLOY_URL in .env)"
              :depends [build]
              :task    (exec 'deploy/run)}

  clean      {:doc  "Remove dist/ and the backend's compiled classes"
              :task (do (fs/delete-tree "dist")
                        (fs/delete-tree "backend/target"))}

  backend    {:doc  "Run the backend on http://localhost:8090 (API, WebSocket and the frontend build)"
              :task (shell backend "clojure -M -m radiolisp.backend.main")}

  test       {:doc     "Run every test: common and frontend on Node, common and backend on the JVM"
              :depends [test:frontend test:backend]}
  test:frontend (do (shell frontend "npx shadow-cljs compile test")
                    (shell frontend "node target/test/node-tests.js"))
  test:backend  (shell backend "clojure -X:test")

  e2e        {:doc  "Browser end-to-end check; needs `bb dev` running (or URL=…)"
              :task (shell frontend "node e2e/check.mjs")}

  lint       {:doc  "Lint with clj-kondo"
              :task (apply shell "clj-kondo --lint" clj-dirs)}

  fmt        {:doc  "Format every Clojure file"
              :task (apply shell "cljfmt fix" clj-dirs)}

  fmt:check  {:doc  "Fail if any Clojure file is not formatted"
              :task (apply shell "cljfmt check" clj-dirs)}}}
